{
  "name": "setSecret",
  "title": "Set Environment Secret (ESV)",
  "description": "Create or update an environment secret (ESV) in PingOne AIC",
  "scopes": [
    "fr:idc:esv:update"
  ],
  "inputSchema": {
    "secretId": {
      "_def": {
        "schema": {
          "_def": {
            "schema": {
              "_def": {
                "checks": [
                  {
                    "kind": "min",
                    "value": 1,
                    "message": "Value cannot be empty"
                  }
                ],
                "typeName": "ZodString",
                "coerce": false
              },
              "~standard": {
                "version": 1,
                "vendor": "zod"
              }
            },
            "typeName": "ZodEffects",
            "effect": {
              "type": "refinement"
            }
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodEffects",
        "effect": {
          "type": "refinement"
        },
        "description": "Secret ID (format: esv-*)"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "valueBase64": {
      "_def": {
        "checks": [],
        "typeName": "ZodString",
        "coerce": false,
        "description": "Base64-encoded value for the secret"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "description": {
      "_def": {
        "innerType": {
          "_def": {
            "checks": [],
            "typeName": "ZodString",
            "coerce": false
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "Optional description of the secret's purpose"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "encoding": {
      "_def": {
        "innerType": {
          "_def": {
            "values": [
              "generic",
              "pem",
              "base64hmac"
            ],
            "typeName": "ZodEnum"
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "Encoding format of the secret value (default: generic)"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "useInPlaceholders": {
      "_def": {
        "innerType": {
          "_def": {
            "typeName": "ZodBoolean",
            "coerce": false
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "Whether the secret can be referenced in placeholder expressions"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    }
  }
}