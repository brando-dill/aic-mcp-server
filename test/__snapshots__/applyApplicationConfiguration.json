{
  "name": "applyApplicationConfiguration",
  "title": "Apply Application Configuration",
  "description": "Apply an OIDC or SAML application configuration, creating or updating as needed. For OIDC: queries IDM for an existing application by name, then creates (AM OAuth2Client + IDM app) or updates (merges config fields). For SAML: queries AM for an existing entity by ID, then creates (hosted POST or remote import) or updates (merges entity config).",
  "scopes": [
    "fr:am:*",
    "fr:idm:*"
  ],
  "inputSchema": {
    "realm": {
      "_def": {
        "values": [
          "alpha",
          "bravo"
        ],
        "typeName": "ZodEnum"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "applicationName": {
      "_def": {
        "checks": [],
        "typeName": "ZodString",
        "coerce": false,
        "description": "Application name"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "clientType": {
      "_def": {
        "values": [
          "oidc",
          "saml"
        ],
        "typeName": "ZodEnum"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "oauth2Client": {
      "_def": {
        "innerType": {
          "_def": {
            "keyType": {
              "_def": {
                "checks": [],
                "typeName": "ZodString",
                "coerce": false
              },
              "~standard": {
                "version": 1,
                "vendor": "zod"
              }
            },
            "valueType": {
              "_def": {
                "typeName": "ZodAny"
              },
              "~standard": {
                "version": 1,
                "vendor": "zod"
              },
              "_any": true
            },
            "typeName": "ZodRecord"
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "AM OAuth2Client config fields (for OIDC)"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "samlEntityId": {
      "_def": {
        "innerType": {
          "_def": {
            "checks": [],
            "typeName": "ZodString",
            "coerce": false
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "SAML entity ID (required for SAML path)"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "samlLocation": {
      "_def": {
        "innerType": {
          "_def": {
            "values": [
              "hosted",
              "remote"
            ],
            "typeName": "ZodEnum"
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "SAML entity location"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "samlEntityConfig": {
      "_def": {
        "innerType": {
          "_def": {
            "keyType": {
              "_def": {
                "checks": [],
                "typeName": "ZodString",
                "coerce": false
              },
              "~standard": {
                "version": 1,
                "vendor": "zod"
              }
            },
            "valueType": {
              "_def": {
                "typeName": "ZodAny"
              },
              "~standard": {
                "version": 1,
                "vendor": "zod"
              },
              "_any": true
            },
            "typeName": "ZodRecord"
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "SAML entity config fields"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    },
    "owners": {
      "_def": {
        "innerType": {
          "_def": {
            "type": {
              "_def": {
                "checks": [],
                "typeName": "ZodString",
                "coerce": false
              },
              "~standard": {
                "version": 1,
                "vendor": "zod"
              }
            },
            "minLength": null,
            "maxLength": null,
            "exactLength": null,
            "typeName": "ZodArray"
          },
          "~standard": {
            "version": 1,
            "vendor": "zod"
          }
        },
        "typeName": "ZodOptional",
        "description": "IDM app owner IDs (for OIDC update path)"
      },
      "~standard": {
        "version": 1,
        "vendor": "zod"
      }
    }
  }
}